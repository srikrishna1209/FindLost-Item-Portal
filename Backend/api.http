####################################################
### GET ALL ITEMS
####################################################

###

GET http://localhost:8080/api/items

####################################################
### GET ITEM BY ID
####################################################

###

GET http://localhost:8080/api/items/1

####################################################
### UPDATE ITEM
####################################################

###

PUT http://localhost:8080/api/items/1
Content-Type: application/json

{
    "itemName": "Updated Wallet",
    "description": "Wallet with ID Cards",
    "location": "Main Block",
    "status": "FOUND"
}

####################################################
### DELETE ITEM
####################################################

###

DELETE http://localhost:8080/api/items/1

####################################################
### SEARCH BY ITEM NAME
####################################################

###

GET http://localhost:8080/api/items/search/name?itemName=Bag

####################################################
### SEARCH BY LOCATION
####################################################

###

GET http://localhost:8080/api/items/search/location?location=Library

####################################################
### PAGINATION
####################################################

###

GET http://localhost:8080/api/items/page?page=0&size=2

###

GET http://localhost:8080/api/items/page?page=1&size=2

####################################################
### SORTING
####################################################

###

GET http://localhost:8080/api/items/sort?field=itemName

###

GET http://localhost:8080/api/items/sort?field=itemName&direction=desc

###

GET http://localhost:8080/api/items/sort?field=location

###

GET http://localhost:8080/api/items/sort?field=id&direction=desc